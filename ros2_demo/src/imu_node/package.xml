<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>imu_node</name>
  <version>0.1.0</version>
  <description>ROS 2 node that consumes IMU data published as JSON over Zenoh and republishes it as sensor_msgs/Imu plus the raw JSON payload.</description>
  <maintainer email="support@hellbender.com">Hellbender Inc</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>

  <!-- eclipse-zenoh is pip-only and mapped in rosdep.yaml at the repo root. -->
  <exec_depend>python3-eclipse-zenoh</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
